# Copy to a mode-0600 host file (e.g. ~/.config/pipeline-supervisor/env).
# Do not commit real secrets or private channel IDs. This file is a template only.

# Target repo checkout for pipeline cwd / ship plane.
# Use the live control checkout (e.g. ap-main-control). Paths matching
# *factory-control* are refused by Tugboat (#1062) — do not point REPO_DIR there.
REPO_DIR=/home/YOU/dev/ap-main-control

# One live production pin: the control-checkout file. Leave unset so Tugboat
# binds $REPO_DIR/.agent-pipeline/production-engine-pin.json. If you set this
# var, it MUST be that same path. v1.40.1 packaging MAY template this file
# and MUST NOT reintroduce a second live pin path.
# AGENT_PIPELINE_PRODUCTION_PIN=$REPO_DIR/.agent-pipeline/production-engine-pin.json

# Use one executable launcher. Do not set this to `node`; the adapter passes
# `ship` as its first argument.
PIPELINE=/home/YOU/.local/bin/pipeline

# Root-owned Ed25519 public key for signed gateway authorizations.
PIPELINE_SHIP_AUTH_PUBLIC_KEY_FILE=/etc/agent-pipeline/ship-authority.pem

# Clone of agent-pipeline that contains examples/supervisor/shell/
AGENT_PIPELINE_ROOT=/home/YOU/dev/agent-pipeline

# Set to 1 only for a private, allowlisted channel that may merge / release finish
ALLOW_MERGE=0

# Notify dedupe state (host-local; Pipeline owns ship state)
PIPELINE_SUPERVISOR_STATE=/home/YOU/.local/state/pipeline-supervisor

# Exact-run material observation. Use the installed host path.
PIPELINE_MATERIAL_FILTER=/home/YOU/.codex/skills/pipeline/scripts/material-filter.mjs

# Optional notify defaults
SHIP_NOTIFY=1
# SHIP_NOTIFY_BIN=$AGENT_PIPELINE_ROOT/examples/supervisor/shell/ship-notify.sh

# Optional Buzz messenger (ship-notify no-ops if unset)
# BUZZ_BIN=/path/to/buzz
# BUZZ_RELAY_URL=https://example.invalid
# BUZZ_CHANNEL=
# BUZZ_CREDENTIALS_FILE=/path/to/buzz-credentials.json
