# Copy to a mode-0600 host file (e.g. ~/.config/pipeline-supervisor/env).
# Do not commit real paths if they are private; this file is a template only.

# Target repo checkout for pipeline cwd
REPO_DIR=/home/YOU/dev/agent-pipeline-factory-control

# Prefer the codex skill launcher (or whichever install you maintain)
PIPELINE=/usr/bin/node /home/YOU/.codex/skills/pipeline/scripts/pipeline.mjs

# Clone of agent-pipeline that contains examples/supervisor/shell/run-intent.sh
AGENT_PIPELINE_ROOT=/home/YOU/dev/agent-pipeline

# Set to 1 only for a private, allowlisted channel that may merge
ALLOW_MERGE=0

# Logs for nohup trains/singles
PIPELINE_SUPERVISOR_STATE=/home/YOU/.local/state/pipeline-supervisor
