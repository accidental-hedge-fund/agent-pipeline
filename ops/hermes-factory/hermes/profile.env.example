# Copy this file to:
#   ~/.hermes/profiles/pipeline-factory/.env
# Set mode 0600. Do not commit the completed file. The controller service must
# not load this file. Hermes loads it only in the gateway and notifier process.

# This path is not a secret. The referenced JSON file is mode 0600 and holds
# the dedicated Nostr private key. This variable is required by the pinned
# native adapter's preflight when the key is not stored in BUZZ_PRIVATE_KEY.
BUZZ_CREDENTIALS_FILE=/home/mcomardo/.hermes/profiles/pipeline-factory/buzz-credentials.json

# Set this only when the Buzz relay requires a NIP-OA owner attestation tag.
# Treat it as a secret.
# BUZZ_AUTH_TAG=REPLACE_WITH_NIP_OA_AUTH_TAG_JSON
