[Unit]
Description=Hermes Pipeline Factory Buzz gateway (v2026.8.3)
Documentation=https://github.com/NousResearch/hermes-agent/releases/tag/v2026.8.3
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/test -x %h/.local/opt/hermes-agent-v2026.8.3/venv/bin/python
ExecStartPre=/usr/bin/test -x %h/.local/opt/buzz-v0.5.2/bin/buzz
ExecStartPre=/usr/bin/test -r %h/.hermes/profiles/pipeline-factory/config.yaml
ExecStartPre=/usr/bin/test -r %h/.hermes/profiles/pipeline-factory/.env
ExecStartPre=/usr/bin/test -r %h/.hermes/profiles/pipeline-factory/buzz-credentials.json
ExecStartPre=/usr/bin/test -r %h/.local/lib/hermes-factory/calibration/check-hermes-buzz-scope.py
ExecStartPre=%h/.local/opt/hermes-agent-v2026.8.3/venv/bin/python %h/.local/lib/hermes-factory/calibration/check-hermes-buzz-scope.py
ExecStart=%h/.local/opt/hermes-agent-v2026.8.3/venv/bin/python -m hermes_cli.main -p pipeline-factory gateway run --external-supervisor
WorkingDirectory=%h/.hermes/profiles/pipeline-factory
Environment="PATH=%h/.local/opt/hermes-agent-v2026.8.3/venv/bin:%h/.local/opt/buzz-v0.5.2/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="VIRTUAL_ENV=%h/.local/opt/hermes-agent-v2026.8.3/venv"
Environment="HERMES_HOME=%h/.hermes/profiles/pipeline-factory"
Environment="AGENT_PIPELINE_PRODUCTION_PIN=/home/mcomardo/.local/state/hermes-factory/production-engine-pin.json"
Environment="PYTHONUNBUFFERED=1"
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN PIPELINE_FRG_ATTESTATION_KEY PIPELINE_FRG_ATTESTATION_KEY_FILE BUZZ_PRIVATE_KEY BUZZ_AUTH_TAG
UMask=0077
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
