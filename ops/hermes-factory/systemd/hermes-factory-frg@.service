[Unit]
Description=Hermes factory isolated FRG scorer for %i
After=hermes-factory.service
BindsTo=hermes-factory.service
PartOf=hermes-factory.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/test -r %h/.local/lib/hermes-factory/lib/frg-attestor.mjs
ExecStartPre=/usr/bin/test -r %h/.local/state/hermes-factory/frg-scorer-requests/%i.json
ExecStart=/usr/bin/node --experimental-strip-types %h/.local/lib/hermes-factory/lib/frg-attestor.mjs attest --request %h/.local/state/hermes-factory/frg-scorer-requests/%i.json
WorkingDirectory=%h/.local/lib/hermes-factory
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="AGENT_PIPELINE_PRODUCTION_PIN=/home/mcomardo/.local/state/hermes-factory/production-engine-pin.json"
LoadCredential=frg_attestation_key:/home/mcomardo/.config/hermes-factory/frg-attestation-key
UnsetEnvironment=BUZZ_PRIVATE_KEY BUZZ_AUTH_TAG PIPELINE_FRG_ATTESTATION_KEY PIPELINE_FRG_ATTESTATION_KEY_FILE
UMask=0077
NoNewPrivileges=true
PrivateNetwork=true
Restart=no
TimeoutStartSec=3600
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# This unit has no [Install] section. frg-runner starts one validated instance.
# Only this scorer unit receives the FRG attestation credential. It must not run
# the synthetic issue loop, a model, a merge, an install, or a general shell.
