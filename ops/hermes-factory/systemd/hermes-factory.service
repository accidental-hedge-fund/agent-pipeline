[Unit]
Description=Scoped Hermes Agent Pipeline release run
After=network-online.target hermes-gateway-pipeline-factory.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=oneshot
ExecStartPre=/usr/bin/test -r %h/.local/lib/hermes-factory/factory.mjs
ExecStartPre=/usr/bin/test -r %h/.config/hermes-factory/config.json
ExecStartPre=/usr/bin/test -r %h/.local/state/hermes-factory/active-grant.json
ExecStartPre=/usr/bin/node %h/.local/lib/hermes-factory/factory.mjs validate-active --config %h/.config/hermes-factory/config.json --grant %h/.local/state/hermes-factory/active-grant.json
ExecStart=/usr/bin/node %h/.local/lib/hermes-factory/factory.mjs run --config %h/.config/hermes-factory/config.json --grant %h/.local/state/hermes-factory/active-grant.json
WorkingDirectory=%h/.local/lib/hermes-factory
Environment="PATH=%h/.local/opt/hermes-agent-v2026.8.3/venv/bin:%h/.local/opt/buzz-v0.5.2/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="NODE_NO_WARNINGS=1"
Environment="AGENT_PIPELINE_PRODUCTION_PIN=/home/mcomardo/.local/state/hermes-factory/production-engine-pin.json"
UnsetEnvironment=BUZZ_PRIVATE_KEY BUZZ_AUTH_TAG PIPELINE_FRG_ATTESTATION_KEY PIPELINE_FRG_ATTESTATION_KEY_FILE
UMask=0077
Restart=on-failure
RestartSec=60
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=infinity
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

# This unit has no [Install] section. Do not enable it. Start one validated
# release run explicitly after the operator receives the threaded grant
# acknowledgment.
