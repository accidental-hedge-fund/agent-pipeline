name: Factory FRG key challenge

on:
  workflow_dispatch:
    inputs:
      challenge:
        description: 32 random bytes in lowercase hexadecimal form
        required: true
        type: string

permissions:
  contents: read

jobs:
  prove:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Compute the non-secret challenge proof
        env:
          PIPELINE_FACTORY_CHALLENGE: ${{ inputs.challenge }}
          PIPELINE_FRG_ATTESTATION_KEY: ${{ secrets.PIPELINE_FRG_ATTESTATION_KEY }}
        run: >-
          node ops/hermes-factory/calibration/frg-key-challenge.mjs
          "$PIPELINE_FACTORY_CHALLENGE"
