#!/bin/sh
# Auto-regenerate the committed SKILL overlay and marketplace catalog when a
# commit touches their sources (core/, hosts/claude/, hosts/_shared/).
#
# The product is the pipeline CLI plus host SKILL. This hook runs
# `node scripts/build.mjs` and may stage SKILL/catalog outputs until #1050.
# It does not regenerate or stage a plugin/ copy of core/scripts as required
# output (#1048).
#
# Opt in per clone with `npm run setup-hooks`. This is convenience, not a gate:
# `node scripts/build.mjs --check` in `npm run ci` / CI remains the authoritative,
# clone-independent enforcement, and `git commit --no-verify` bypasses this hook.

set -e

# Run from the repo root so `node scripts/build.mjs` and the staged paths resolve.
cd "$(git rev-parse --show-toplevel)"

# Only regenerate when the staged change set touches generator inputs.
# (No --diff-filter: a staged deletion under core/ must also refresh owned outputs.)
# hosts/_shared/ is included because build.mjs stages shared plugin-shell assets
# such as material-filter.mjs. The marketplace launcher itself is a managed-install bridge.
staged=$(git diff --cached --name-only --no-renames)
if ! printf '%s\n' "$staged" | grep -Eq '^(core/|hosts/claude/|hosts/_shared/)'; then
  exit 0
fi

echo "pre-commit: core/, hosts/claude/, or hosts/_shared/ staged — regenerating SKILL overlay / marketplace catalog"

# Guard: abort if the working tree has unstaged tracked edits under generator inputs.
# build.mjs reads the working tree, not the index, so an unstaged source change
# could produce SKILL/catalog output that doesn't match the staged source files,
# silently committing effects of unstaged work.
unstaged_src=$(git diff --name-only -- core/ hosts/claude/ hosts/_shared/)
if [ -n "$unstaged_src" ]; then
  echo "pre-commit: aborting — unstaged changes found in generator inputs:"
  printf '%s\n' "$unstaged_src" | sed 's/^/  /'
  echo "Stage or stash all core/, hosts/claude/, and hosts/_shared/ changes before committing."
  exit 1
fi

# Guard: abort if untracked files exist under generator inputs. The generator
# reads from the working tree, so local scratch must not influence committed
# SKILL/catalog output without being reviewed and staged.
untracked_src=$(git ls-files --others --exclude-standard -- core/ hosts/claude/ hosts/_shared/)
if [ -n "$untracked_src" ]; then
  echo "pre-commit: aborting — untracked files found in generator inputs:"
  printf '%s\n' "$untracked_src" | sed 's/^/  /'
  echo "Track, stash, or remove untracked files in core/ and hosts/ before committing."
  exit 1
fi

node scripts/build.mjs

# Stage only files owned by scripts/build.mjs. Do not use `git add plugin/`:
# that would absorb unrelated plugin/ working-tree changes into this commit.
for generated_path in \
  .claude-plugin/marketplace.json \
  plugin/pipeline/skills/pipeline/SKILL.md
do
  # The #1048 hook contract stages only the two freshness-gated outputs. The
  # tracked check also makes a future deletion stageable without a broad path.
  if [ -e "$generated_path" ] || git ls-files --error-unmatch -- "$generated_path" >/dev/null 2>&1; then
    git add -- "$generated_path"
  fi
done
